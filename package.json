{
  "name": "dsh-token-usage-heatmap",
  "version": "0.1.0",
  "type": "module",
  "description": "Token usage panel for the DSH Web GUI: a 26-week daily heatmap, a per-model bar chart and a header chip, all read from local session logs.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "token",
    "usage",
    "heatmap",
    "statistics"
  ],
  "author": "savasana168",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savasana168/dsh-token-usage-heatmap.git"
  },
  "homepage": "https://github.com/savasana168/dsh-token-usage-heatmap#readme",
  "bugs": {
    "url": "https://github.com/savasana168/dsh-token-usage-heatmap/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/usage.js",
    "lib/fold.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
